# Backend Environment Configuration
# Copy this file to .env and fill in your values

# ── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=tuition_ms

# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_to_a_long_random_string_access
JWT_REFRESH_SECRET=change_this_to_a_long_random_string_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── CORS ─────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173

# ── File Uploads ─────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
